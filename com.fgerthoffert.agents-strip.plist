<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.fgerthoffert.agents-strip</string>

    <!-- Launch the agent strip once the GUI login session is up. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/fgerthoffert/.config/tmux/agents-strip.sh</string>
        <string>start</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>ProcessType</key>
    <string>Interactive</string>

    <key>StandardOutPath</key>
    <string>/Users/fgerthoffert/.cache/agents-strip.launch.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/fgerthoffert/.cache/agents-strip.launch.log</string>
</dict>
</plist>
